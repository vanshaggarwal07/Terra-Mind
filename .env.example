# ---------------------------------------------------------------------------
# Property Digital Twin — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Postgres + PostGIS + pgvector) ---
# Local docker-compose default; override in prod.
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin
POSTGRES_DB=twin

# --- Object storage (raw cache tier). Local = MinIO; prod = S3/GCS/R2 ---
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=twin-raw-cache
OBJECT_STORAGE_REGION=us-east-1

# --- LLM / RAG provider (vendor-agnostic; check pricing at build time) ---
LLM_PROVIDER=openai
LLM_API_KEY=changeme
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIM=1536

# --- HTTP crawler defaults ---
HTTP_USER_AGENT=PropertyDigitalTwinBot/1.0 (+https://example.com/bot)
HTTP_DEFAULT_RATE_LIMIT_PER_SEC=1.0
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=0.5

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=local

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=changeme
