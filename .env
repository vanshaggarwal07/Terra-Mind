# ---------------------------------------------------------------------------
# Property Digital Twin — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Postgres + PostGIS + pgvector) ---
# Local docker-compose default; override in prod.
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin
POSTGRES_DB=twin

# --- Object storage (raw cache tier). Local = MinIO; prod = S3/GCS/R2 ---
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=twin-raw-cache
OBJECT_STORAGE_REGION=us-east-1

# --- LLM / RAG provider (vendor-agnostic; check pricing at build time) ---
LLM_PROVIDER=xai
LLM_API_KEY=changeme
LLM_MODEL=grok-3
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIM=1536

# --- xAI Grok (primary LLM: copilot + social/tweet analysis) ---
# Set XAI_API_KEY to activate Grok. It takes priority over LLM_API_KEY.
# Grok is OpenAI-compatible so the same LLMClient handles both.
XAI_API_KEY=changeme
XAI_MODEL=grok-3
XAI_BASE_URL=https://api.x.ai/v1

# --- Social / X (Twitter) analysis ---
# Set ENABLE_X_SOCIAL=true and a budget to allow tweet ingestion.
ENABLE_X_SOCIAL=false
BUDGET_X_SOCIAL_USD=50.0

# --- Optional expensive features ---
ENABLE_SATELLITE=false
ENABLE_GPU_BATCH=false
BUDGET_SATELLITE_USD=200.0
BUDGET_GPU_USD=300.0

# --- HTTP crawler defaults ---
HTTP_USER_AGENT=PropertyDigitalTwinBot/1.0 (+https://example.com/bot)
HTTP_DEFAULT_RATE_LIMIT_PER_SEC=1.0
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=0.5

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=local

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=changeme
