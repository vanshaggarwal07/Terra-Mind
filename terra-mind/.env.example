# Google Sheets (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=terra-mind@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# Sheet tabs expected:
# - Listings (A2:AC) — property rows (V:AC optional: filmCityKm, driveMinAirport,
#   driveMinFilmCity, reraId, titleVerified, verifiedOn, verificationNotes, images)
# - Activity (A:H) — timestamp, action, propertyId, name, email, phone, message, meta

# --- Direct contact (used by WhatsApp/call CTAs across the site) ---
# WhatsApp number: country code + number, digits only (no +, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
# Phone as it should display on the site (tel: link strips formatting)
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
NEXT_PUBLIC_CONTACT_EMAIL=hello@terra-mind.in

# Canonical site URL for metadata / sitemap / OG tags (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://terra-mind.example

# --- Corridor Signal Feed ---
# Vercel Postgres / Neon connection string (required on Vercel)
POSTGRES_URL=

# NewsAPI.org key (free Developer plan is localhost-only)
NEWSAPI_KEY=

# Protects POST/GET /api/cron/sync-news (Vercel Cron sends Bearer automatically when set)
CRON_SECRET=

# Polling guidance for external schedulers
# NewsAPI free ~100 req/day; ~8 corridor queries per sync → keep >= 180 (max ~12 syncs/day)
NEWS_SYNC_INTERVAL_MINUTES=180

# X / Twitter monitoring (paid API) — leave disabled until credentials exist
X_MONITORING_ENABLED=false
X_BEARER_TOKEN=
