# Dagster image (ingestion orchestration + doc-intelligence + satellite fetch).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DAGSTER_HOME=/opt/dagster

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY packages ./packages
RUN pip install \
    ./packages/common \
    ./packages/warehouse \
    ./packages/ingestion \
    ./packages/ml \
    ./packages/cv

RUN mkdir -p /opt/dagster && useradd --create-home appuser && chown -R appuser /opt/dagster
USER appuser

# Serves the Dagster webserver + daemon (schedules the crawler fleet + CV batch).
CMD ["dagster", "dev", "-m", "ingestion.orchestrator", "-h", "0.0.0.0", "-p", "3000"]
