# Postgres 16 with BOTH PostGIS (from the base image) and pgvector.
# The stock postgis image ships PostGIS but not pgvector, so we add the
# PGDG pgvector package here. Used by docker-compose locally and CI.
FROM postgis/postgis:16-3.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*

# Extensions themselves are enabled per-database by docker/db-init.sql.
